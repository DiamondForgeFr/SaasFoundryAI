{
  "$schema": "https://raw.githubusercontent.com/DiamondForgeFr/SaasFoundryAI/master/schemas/saasfoundry-manifest.schema.json",
  "version": "1.3.0",
  "projectName": "saasfoundryai-cli",
  "structure": "cli",
  "language": {
    "srs": "en",
    "tickets": "en",
    "codeComments": "en"
  },
  "workflow": {
    "tool": "github-projects",
    "template": "SaaSFoundry Solo",
    "projectUrl": "https://github.com/orgs/DiamondForgeFr/projects/1",
    "workingBranch": "develop",
    "prTargetBranch": "develop",
    "releaseBranch": "master",
    "branchNaming": {
      "feature": "feature/{N}-{description}",
      "fix": "fix/{N}-{description}",
      "release": "rc-{version}"
    },
    "commitFormat": {
      "pattern": "<type>(#<ticket>): <description>",
      "requireTicket": true,
      "types": ["feat", "fix", "docs", "style", "refactor", "perf", "test", "chore", "ci", "build", "revert"]
    },
    "statuses": [
      {
        "name": "Backlog",
        "description": "Raw ideas and specs waiting to be challenged. AI must challenge the ticket with the developer to clarify requirements, identify edge cases, and validate approach before starting. Complexity label is mandatory before leaving Backlog.",
        "color": "GRAY"
      },
      {
        "name": "In progress",
        "description": "Task currently being worked on by AI after the developer confirmed pickup. One commit per subtask. When all subtasks are done: run existing tests (unit, E2E, lint, TypeScript), commit and push all changes, then move to AI Testing and generate a test plan.",
        "color": "BLUE"
      },
      {
        "name": "AI testing",
        "description": "Validation phase. Execute the generated test plan step by step, document findings in ticket comments, fix and re-test on failure. When all tests pass: post the test report, create the pull request and move to In Review — the PR review is where the developer validates.",
        "color": "PURPLE"
      },
      {
        "name": "In review",
        "description": "Pull request open — this is the human gate of the solo workflow. The developer reviews the changes (and tests manually if needed); AI monitors CI and review comments and addresses feedback. The developer merging the PR is what moves the ticket to Done.",
        "color": "PINK"
      },
      {
        "name": "Done",
        "description": "PR merged to the working branch. Close the ticket, clean up local branches, and update any related documentation.",
        "color": "GREEN"
      }
    ],
    "issueTypes": [
      {
        "name": "sf-epic",
        "description": "Grouper for related sf-stories/sf-tasks (no PR, no branch)",
        "color": "PURPLE"
      },
      {
        "name": "sf-story",
        "description": "Delivers user-observable value",
        "color": "BLUE"
      },
      {
        "name": "sf-task",
        "description": "Delivers a technical action (refactor, infra, tooling)",
        "color": "GRAY"
      },
      {
        "name": "sf-issue",
        "description": "Defect or unexpected behavior to investigate and fix",
        "color": "RED"
      }
    ],
    "localCi": {
      "requiredStatuses": [
        "local-format",
        "local-impact-contract",
        "local-lint",
        "local-build",
        "local-package",
        "local-unit",
        "local-integration",
        "local-e2e",
        "local-docs-build",
        "local-docs-integrity",
        "local-docker-normal"
      ]
    },
    "validated": false
  },
  "tools": {
    "srs": {
      "enabled": true,
      "backend": "notion",
      "rootPage": {
        "id": "34ba31bb-4f3f-8139-a6e4-f4327648a6b9",
        "url": "https://app.notion.com/p/SaaSFoundryAI-srs-34ba31bb4f3f8139a6e4f4327648a6b9",
        "name": "SaaSFoundryAI-srs"
      },
      "scan": {
        "exclude": ["scaffolds/", "docs/", ".claude/", ".srs-audit/"]
      }
    }
  },
  "modules": {
    "harness": {
      "version": 5,
      "agents": ["claude-code", "codex", "kimi"],
      "managed": true,
      "delegation": {
        "ticketDelivery": "allowed",
        "decidedAt": "2026-10-19T15:34:52.506Z"
      }
    },
    "email": {
      "provider": "none",
      "version": 1
    }
  },
