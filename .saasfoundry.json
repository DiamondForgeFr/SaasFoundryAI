{
  "version": "1.0.1",
  "projectName": "saasfoundryai-cli",
  "structure": "cli",
  "language": {
    "srs": "en",
    "tickets": "en",
    "codeComments": "en"
  },
  "workflow": {
    "tool": "github-projects",
    "template": "SaaSFoundry AI",
    "projectUrl": "https://github.com/orgs/DiamondForgeFr/projects/1",
    "workingBranch": "develop",
    "prTargetBranch": "develop",
    "releaseBranch": "master",
    "branchNaming": {
      "feature": "feature/{N}-{description}",
      "fix": "fix/{N}-{description}",
      "release": "rc-{version}"
    },
    "commitFormat": {
      "pattern": "<type>(#<ticket>): <description>",
      "requireTicket": true,
      "types": ["feat", "fix", "docs", "style", "refactor", "perf", "test", "chore", "ci", "build", "revert"]
    },
    "statuses": [
      {
        "name": "Backlog",
        "color": "GRAY"
      },
      {
        "name": "Ready",
        "color": "YELLOW"
      },
      {
        "name": "In progress",
        "color": "BLUE"
      },
      {
        "name": "AI testing",
        "color": "PURPLE"
      },
      {
        "name": "Human testing",
        "color": "ORANGE"
      },
      {
        "name": "In review",
        "color": "PINK"
      },
      {
        "name": "Done",
        "color": "GREEN"
      }
    ],
    "issueTypes": [
      {
        "name": "sf-epic",
        "description": "Grouper for related sf-stories/sf-tasks (no PR, no branch)",
        "color": "PURPLE"
      },
      {
        "name": "sf-story",
        "description": "Delivers user-observable value",
        "color": "BLUE"
      },
      {
        "name": "sf-task",
        "description": "Delivers a technical action (refactor, infra, tooling)",
        "color": "GRAY"
      },
      {
        "name": "sf-issue",
        "description": "Defect or unexpected behavior to investigate and fix",
        "color": "RED"
      }
    ]
  },
  "tools": {
    "srs": {
      "enabled": true,
      "backend": "notion",
      "rootPage": {
        "id": "34ba31bb-4f3f-8139-a6e4-f4327648a6b9",
        "url": "https://app.notion.com/p/SaaSFoundryAI-srs-34ba31bb4f3f8139a6e4f4327648a6b9",
        "name": "SaaSFoundryAI-srs"
      },
      "scan": {
        "exclude": ["scaffolds/", "docs/", ".claude/", ".srs-audit/"]
      }
    }
  },
  "modules": {
    "harness": {
      "version": 1,
      "agents": ["claude-code", "codex"]
    }
  },
