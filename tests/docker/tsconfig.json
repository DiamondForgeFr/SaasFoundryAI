{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@playwright/test": ["runtime/node_modules/@playwright/test"],
      "@playwright/test/*": ["runtime/node_modules/@playwright/test/*"],
      "pg": ["runtime/node_modules/pg"]
    },
    "typeRoots": ["runtime/node_modules/@types", "../../node_modules/@types"]
  },
  "include": ["**/*.ts"],
  "exclude": ["fixtures/**", "runtime/node_modules/**"]
}
