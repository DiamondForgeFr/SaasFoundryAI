# Get the current branch name
current_branch=$(git symbolic-ref --short HEAD)
echo "Preparing to push branch: $current_branch"

# Get remote and URL information
remote="$1"
url="$2"

# RC pushes are validation-only. Version changes must already be committed,
# and release tags are created from the verified master commit after merge.
if [[ "$current_branch" =~ ^rc- ]]; then
  echo "Release candidate branch detected: $current_branch"
  expected_version="${current_branch#rc-}"
  current_version=$(node -p "require('./package.json').version")

  if [[ ! "$expected_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]]; then
    echo "❌ Invalid release branch name. Expected rc-X.Y.Z, got $current_branch."
    exit 1
  fi

  if [ "$current_version" != "$expected_version" ]; then
    echo "❌ Release version mismatch: $current_branch expects $expected_version, package.json contains $current_version."
    echo "Prepare and commit the version before pushing the RC branch:"
    echo "  npm version $expected_version --no-git-tag-version"
    echo "  git commit -am 'chore(#<ticket>): prepare v$expected_version'"
    exit 1
  fi

  if git ls-remote --exit-code --tags "$remote" "refs/tags/v$current_version" >/dev/null 2>&1; then
    echo "❌ Tag v$current_version already exists on $remote; refusing to reuse a published version."
    exit 1
  fi

  echo "✅ RC version is committed and v$current_version is still available."
  echo "Create the tag only after this RC is merged and the master commit is verified."
else
  # Not a RC branch
  echo "This is not a release candidate branch."
  echo "NOTE: To use automatic version and tag management, name your branches with 'rc-' prefix"
  echo "      (e.g., 'rc-feature', 'rc-bugfix', etc.)"

  # Optional: Check for WIP commits before pushing
  if git log @{u}..HEAD --pretty=format:"%s" | grep -q "WIP"; then
    echo "WARNING: Your branch contains WIP commits."
    read -p "Continue pushing with WIP commits? (y/n) " continue_wip < /dev/tty
    if [ "$continue_wip" != "y" ]; then
      echo "Push aborted."
      exit 1
    fi
  fi

  # Heavy validation belongs to AI testing, before the draft PR enters Human testing.
  # Keep pushes during human feedback inexpensive; pre-commit checks still apply.
  echo "Before Human testing, run npm run test:pre-push during AI testing and record the results."
  echo "Full CI runs when the PR is marked ready for review and on subsequent pushes."
fi

# All checks passed
echo "All pre-push checks passed. Proceeding with push..."
exit 0
