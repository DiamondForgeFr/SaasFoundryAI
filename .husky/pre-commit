# The commit lands on a branch the workflow names after its ticket, a long-lived branch, a host-named
# agent branch or a detached HEAD (#1232): see workflow-branch-guard.mjs. Checked first, before the tests,
# and while the hook's repository bindings still name this repository.
sf_branch_guard="$(dirname "$0")/workflow-branch-guard.mjs"
if [ -f "$sf_branch_guard" ]; then
  node "$sf_branch_guard" commit
fi

# Tests create foreign Git repositories. Do not pass the hook's repository
# bindings to those subprocesses (especially when committing from a worktree).
sf_hook_git_vars=$(git rev-parse --local-env-vars) || exit $?
unset $sf_hook_git_vars
npm run test:staged
