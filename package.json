{
  "name": "saasfoundryai-cli",
  "version": "1.0.0-beta",
  "author": "Anthony Gachet <anthony.gachet@diamondforge.fr>",
  "license": "MIT",
  "description": "CLI for SaaSFoundryAI - Integrated SaaS Development Platform",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.0.0",
      "onFail": "error"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiamondForgeFr/SaaSFoundryAI.git"
  },
  "bugs": {
    "url": "https://github.com/DiamondForgeFr/SaaSFoundryAI/issues"
  },
  "homepage": "https://www.npmjs.com/package/saasfoundryai-cli",
  "keywords": [
    "cli",
    "saas",
    "starter-kit",
    "nestjs",
    "react",
    "typescript",
    "rbac"
  ],
  "files": [
    "dist",
    "bin",
    "scaffolds"
  ],
  "bin": {
    "sf": "./bin/sf.js",
    "saasfoundryai": "./bin/sf.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:e2e": "jest --selectProjects e2e",
    "test:smoke": "jest --selectProjects smoke",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\" --ignore-path .prettierignore",
    "lint": "eslint --config eslint.config.mjs .",
    "prepublishOnly": "rm -rf dist && npm run build",
    "link": "npm link --force",
    "uninstall": "npm unlink -g saasfoundryai-cli && hash -r",
    "prepare": "husky",
    "test:pre-commit": "npm run format && npm run lint && npm run build && npm test",
    "test:pre-push": "npm run test:docker -- --count 2",
    "test:full": "npm run test:pre-commit && npm run test:pre-push",
    "test:docker": "bash tests/docker/run-docker-tests.sh",
    "test:docker:count": "bash tests/docker/run-docker-tests.sh --count",
    "test:docker:scenario": "bash tests/docker/run-docker-tests.sh --scenario",
    "test:docker:list": "bash tests/docker/run-docker-tests.sh --list",
    "publish:beta": "npm run build && npm publish --tag beta",
    "publish:latest": "npm run build && npm publish --tag latest",
    "publish:check": "npm dist-tag ls saasfoundryai-cli",
    "version:manage": "./scripts/tag-manager.sh \"$(git symbolic-ref --short HEAD)\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:generate": "tsx scripts/generate-cli-docs.ts",
    "postinstall": "if [ \"$CI\" != \"true\" ] && [ \"$HUSKY\" != \"0\" ] && [ \"$npm_config_global\" != \"true\" ]; then husky install && find .husky -type f -exec chmod +x {} + 2>/dev/null || true && if [ -d './scripts' ]; then find ./scripts -type f -name '*.sh' -exec chmod +x {} + 2>/dev/null || true; fi; fi"
  },
  "config": {
    "loglevel": "error"
  },
  "dependencies": {
    "@notionhq/client": "5.19.0",
    "@types/fs-extra": "11.0.4",
    "chalk": "4.1.2",
    "commander": "12.0.0",
    "fs-extra": "11.3.0",
    "ignore": "7.0.5",
    "inquirer": "8.2.7",
    "module-alias": "2.2.3",
    "ora": "5.4.1",
    "shelljs": "0.10.0",
    "simple-git": "3.36.0",
    "terminal-link": "5.0.0",
    "typescript": "5.7.3"
  },
  "devDependencies": {
    "@commitlint/cli": "19.6.1",
    "@commitlint/config-conventional": "19.6.0",
    "@types/inquirer": "8.2.5",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/module-alias": "2.0.4",
    "@types/node": "22.14.0",
    "@types/shelljs": "0.8.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.19.0",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-prettier": "5.2.3",
    "globals": "15.14.0",
    "husky": "8.0.0",
    "jest": "29.7.0",
    "js-yaml": "4.1.1",
    "prettier": "3.4.2",
    "ts-jest": "29.4.6",
    "tsx": "4.21.0",
    "typescript-eslint": "8.20.0",
    "vitepress": "1.6.4"
  },
  "overrides": {
    "glob": "7.2.3",
    "minimatch": "3.1.2",
    "rimraf": "3.0.2",
    "inflight": "1.0.6",
    "npmlog": "6.0.2",
    "gauge": "4.0.4",
    "are-we-there-yet": "2.0.0"
  }
}
