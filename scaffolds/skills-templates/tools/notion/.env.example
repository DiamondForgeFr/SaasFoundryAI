# Notion API credentials (runtime)
# Required for notion-cli.sh and for src/tools/notion/srs.adapter.ts (via createNotionSrsAdapterFromEnv)
NOTION_API_TOKEN="secret_your_integration_token"
NOTION_API_VERSION="2022-06-28"

# Integration-test sandbox (only set for `npm test` against a throwaway Notion workspace)
# Tests are skipped via describe.skip when either of these is unset.
# NOTION_INTEGRATION_TOKEN="secret_sandbox_integration_token"
# NOTION_SANDBOX_PARENT_PAGE_ID="abcdef0123456789abcdef0123456789"
