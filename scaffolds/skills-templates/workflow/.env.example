# Workflow Configuration
# This file is generated by SaaSFoundry based on your workflow setup

# Workflow tool (github-projects, jira, notion, linear, none)
WORKFLOW_TOOL="{{WORKFLOW_TOOL}}"

# Project management tool URL
PROJECT_URL="{{PROJECT_URL}}"

# Working branch (branch to rebase from and create PRs to)
WORKING_BRANCH="{{WORKING_BRANCH}}"

# PR target branch (if different from working branch)
PR_TARGET_BRANCH="{{PR_TARGET_BRANCH}}"

# Workflow name
WORKFLOW_NAME="{{WORKFLOW_NAME}}"
