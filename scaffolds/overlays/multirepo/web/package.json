{
  "name": "saasfoundry-web",
  "version": "1.0.0",
  "description": "SaaSFoundryAI: Our new SaaS frontend application",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/agachet/saasfoundry/apps/web"
  },
  "homepage": "https://github.com/agachet/saasfoundry/#readme",
  "bugs": {
    "url": "https://github.com/agachet/saasfoundry/issues"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=11.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.13.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier --write .",
    "lint": "eslint .",
    "preview": "vite preview",
    "type-check": "tsc -b",
    "type-check:watch": "tsc -b --watch",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:ui": "E2E_DEBUG=true playwright test --ui",
    "test:e2e:debug": "E2E_DEBUG=true playwright test --project=chromium --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:full": "npm run format && npm run lint && npm run type-check && npm run test:e2e",
    "version:manage": "./scripts/tag-manager.sh \"$(git symbolic-ref --short HEAD)\"",
    "postinstall": "if [ \"$CI\" = \"true\" ]; then npx playwright install --with-deps || echo '\u26a0 Playwright browsers not installed \u2014 run: npx playwright install'; else npx playwright install || echo '\u26a0 Playwright browsers not installed \u2014 run: npx playwright install'; fi; if [ \"$HUSKY\" != \"0\" ]; then find .husky -type f -exec chmod +x {} + 2>/dev/null || true; if [ -d './scripts' ]; then find ./scripts -type f -name '*.sh' -exec chmod +x {} +; fi; fi"
  },
  "keywords": [
    "saasfoundry",
    "open-source",
    "frontend",
    "react",
    "vite"
  ],
  "author": "Your Name <anthony.gachet@diamondforge.fr> (https://agachet.diamondforge.fr)",
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@tanstack/react-query": "5.100.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "i18next": "26.0.8",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-resources-to-backend": "1.2.1",
    "js-cookie": "3.0.7",
    "js-yaml": "4.3.1",
    "lucide-react": "1.14.0",
    "radix-ui": "1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "7.75.0",
    "react-i18next": "17.0.6",
    "react-router-dom": "7.18.2",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.4",
    "tw-animate-css": "1.4.0",
    "yaml": "2.8.4",
    "zod": "4.4.2"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.59.1",
    "@tailwindcss/vite": "4.2.4",
    "@types/js-cookie": "3.0.6",
    "@types/js-yaml": "4.0.9",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsonc": "2.21.1",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "terser": "5.46.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.1",
    "vite": "8.0.10"
  }
}
