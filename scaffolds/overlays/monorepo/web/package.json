{
  "name": "{{PROJECT_NAME}}-web",
  "version": "1.0.0",
  "description": "{{PROJECT_NAME}}, generated with SaaSFoundryAI",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/agachet/saasfoundry.git"
  },
  "homepage": "https://github.com/agachet/saasfoundry/#readme",
  "bugs": {
    "url": "https://github.com/agachet/saasfoundry/issues"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=11.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.13.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "wait-on -t 60000 tcp:3500 && vite",
    "build": "tsc -b && vite build",
    "format": "prettier --write .",
    "lint": "eslint .",
    "preview": "vite preview",
    "type-check": "tsc -b",
    "type-check:watch": "tsc -b --watch",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "E2E_DEBUG=true playwright test --ui",
    "test:e2e:debug": "E2E_DEBUG=true playwright test --project=chromium --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:full": "npm run format && npm run lint && npm run type-check && npm run test:e2e",
    "postinstall": "if [ \"$SF_SKIP_PLAYWRIGHT_INSTALL\" != \"1\" ]; then if [ \"$CI\" = \"true\" ]; then npx playwright install --with-deps || echo '\u26a0 Playwright browsers not installed \u2014 run: npx playwright install'; else npx playwright install || echo '\u26a0 Playwright browsers not installed \u2014 run: npx playwright install'; fi; fi"
  },
  "keywords": [
    "{{PROJECT_NAME}}",
    "saasfoundry",
    "frontend",
    "react",
    "vite"
  ],
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@{{PROJECT_NAME}}/api-client": "*",
    "@{{PROJECT_NAME}}/shared-config": "*",
    "@{{PROJECT_NAME}}/shared-types": "*",
    "@{{PROJECT_NAME}}/shared-validation": "*",
    "@{{PROJECT_NAME}}/ui-primitives": "*",
    "@tanstack/react-query": "5.107.1",
    "i18next": "26.7.2",
    "i18next-browser-languagedetector": "8.3.0",
    "i18next-resources-to-backend": "1.2.4",
    "js-cookie": "3.0.8",
    "js-yaml": "5.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-i18next": "17.1.13",
    "react-router-dom": "7.18.5",
    "tailwindcss": "4.3.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.59.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/js-cookie": "3.0.6",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "terser": "5.51.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "4.1.12",
    "wait-on": "9.5.1"
  }
}
