{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["src/**", "tsconfig.json", "tsconfig.build.json", "package.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format": {
      "cache": false
    },
    "lint": {
      "outputs": [],
      "inputs": ["src/**", "eslint.config.mjs"]
    },
    "lint:fix": {
      "outputs": [],
      "cache": false
    },
    "type-check": {
      "outputs": [],
      "inputs": ["src/**", "tsconfig.json", "tsconfig.app.json", "tsconfig.node.json"]
    },
    "test:unit": {
      "outputs": ["coverage/**"],
      "inputs": ["src/**", "jest.config.js"]
    },
    "test:e2e": {
      "cache": false,
      "inputs": ["src/**", "tests/**"]
    },
    "test:full": {
      "cache": false
    }
  }
}
