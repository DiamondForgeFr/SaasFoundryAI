{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["src/**", "tsconfig.json", "tsconfig.build.json", "package.json"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "format": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["src/**", "eslint.config.mjs"]
    },
    "lint:fix": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["src/**", "tsconfig*.json"]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["src/**", "jest.config.js", "vitest.config.ts"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "inputs": ["src/**", "tests/**"]
    },
    "test:full": {
      "cache": false
    },
    "codegen": {
      "cache": false,
      "outputs": ["src/generated/**"],
      "inputs": ["orval.config.ts", "../../apps/api/docs/openapi.json"]
    }
  }
}
