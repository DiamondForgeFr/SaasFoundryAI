{
  "name": "@{{PROJECT_NAME}}/ui-primitives",
  "version": "0.0.1",
  "description": "Headless ShadCN/Radix UI primitives + Tailwind v4 theme tokens shared by every frontend in the monorepo",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./*": "./src/*.tsx"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "0.564.0",
    "radix-ui": "1.4.3",
    "tailwind-merge": "3.4.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.71.1",
    "typescript": "5.9.3"
  }
}
