# node and npm are the ones .nvmrc names, even when the committing shell has an older Node first on PATH (#1317).
sf_project_node="$(dirname "$0")/project-node.sh"
if [ -f "$sf_project_node" ]; then
  . "$sf_project_node"
fi

# The commit lands on a branch the workflow names after its ticket, a long-lived branch, a host-named
# agent branch or a detached HEAD (#1232): see workflow-branch-guard.mjs. Checked first, before the tests.
sf_branch_guard="$(dirname "$0")/workflow-branch-guard.mjs"
if [ -f "$sf_branch_guard" ]; then
  node "$sf_branch_guard" commit
fi
npm run test:staged
