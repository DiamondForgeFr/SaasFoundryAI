/**
 * Enums
 */
enum OrganizationType {
  COMPANY
  ASSOCIATION
  COMMUNITY

  @@map("organization_type")
}

/**
 * Table : Organization
 */
model Organization {
  id          String           @id @default(cuid())
  name        String           @db.VarChar(100)
  type        OrganizationType
  description String?          @db.VarChar(255)
  website     String?          @db.VarChar(100)
  logoUrl     String?          @map("logo_url") @db.VarChar(500)
  entityId    String?          @unique @map("entity_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  entity Entity? @relation("EntityProfile", fields: [entityId], references: [id], onDelete: Cascade)

  accountsLinked OrganizationAccountLink[]

  @@map("organizations")
}

/**
 * Table : Entity
 */
model Entity {
  id             String   @id @default(cuid())
  // NO name / description — human identity is resolved from the typed profile (D-ENT-6, §3.4).
  accountId      String
  parentEntityId String?  @map("parent_entity_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  account      Account       @relation("EntityAccount", fields: [accountId], references: [id], onDelete: Cascade)
  organization Organization? @relation("EntityProfile")

  // Recursive entity tree (adjacency list): null parent = root entity (direct child of the account).
  // A child may be of a different type than its parent (type is derived from its attached profile).
  parent   Entity?  @relation("EntityTree", fields: [parentEntityId], references: [id], onDelete: Cascade)
  children Entity[] @relation("EntityTree")

  users             UserEntityLink[]
  roleAssignments   UserRoleAssignment[] @relation("EntityRoleAssignments")
  peoples           PeopleEntityLink[]
  invitationsLinked InvitationEntityLink[]

  @@index([accountId])
  @@index([parentEntityId])
  @@index([isActive])
  @@map("entities")
}

/**
 * Table : Relation User - Entity
 * This establishes a many-to-many relationship between users and entities
 */
model UserEntityLink {
  userId    String   @map("user_id")
  entityId  String   @map("entity_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([userId, entityId])
  @@index([userId])
  @@index([entityId])
  @@map("users_entities_links")
}

/**
 * Table : EntityType
 * Registry of the profile tables eligible to be an entity type. The concrete kind of an entity
 * (Organization, Team, …) is derived from which registered profile row carries its entityId.
 */
model EntityType {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  tableName String   @map("table_name") @db.VarChar(63)
  label     String   @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("entity_types")
}

/**
 * Table : Relation Organization - Account
 * This establishes a many-to-many relationship between organizations and accounts
 */
model OrganizationAccountLink {
  organizationId String   @map("organization_id")
  accountId      String   @map("account_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([organizationId, accountId])
  @@index([organizationId])
  @@index([accountId])
  @@map("organizations_accounts_links")
}

/**
 * Table : Relation Entity - People
 * This establishes a many-to-many relationship between entities and people
 */
model PeopleEntityLink {
  peopleId  String   @map("people_id")
  entityId  String   @map("entity_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  people People @relation(fields: [peopleId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([peopleId, entityId])
  @@index([peopleId])
  @@index([entityId])
  @@map("peoples_entities_links")
}
